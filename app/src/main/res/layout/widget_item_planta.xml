<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_planta"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widgetItemIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_plant"
        android:layout_gravity="center_vertical"
        android:tint="#2E7D32"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre Planta"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widgetItemInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riego: 3 días"
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widgetAction"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_water_drop"
        android:layout_gravity="center"
        android:tint="#0288D1"/>

</LinearLayout>